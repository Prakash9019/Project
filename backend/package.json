    "@types/nodemailer": "^8.0.1",
    "agora-access-token": "^2.0.4",
    "basic-auth": "^2.0.1",
    "bull": "^4.16.5",
    "compression": "^1.7.4",
    "connect-timeout": "^1.9.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "file-type": "^19.0.0",
