{
  "project": "Proximity Social — Real-Time Nearby Social Discovery Layer",
  "baseUrl": "http://localhost:4000",
  "stack": {
    "language": "TypeScript",
    "framework": "Express",
    "database": "PostgreSQL",
    "orm": "Prisma",
    "auth": "JWT (phone + OTP, passwordless)",
    "realtime": "Socket.IO",
    "cache": "Redis (geo-spatial index, OTP, rate limits, presence)"
  },
  "auth": {
    "strategy": "jwt",
    "tokenLocation": "Authorization header, Bearer scheme",
    "tokenExpiry": "15m",
    "refreshToken": true,
    "refreshExpiry": "7d",
    "passwordless": true,
    "flow": "POST /auth/request-otp → POST /auth/verify-otp → accessToken+refreshToken. User upserted on first verification.",
    "endpoints": {
      "requestOtp": "POST /api/v1/auth/request-otp",
      "verifyOtp": "POST /api/v1/auth/verify-otp",
      "refresh": "POST /api/v1/auth/refresh",
      "logout": "POST /api/v1/auth/logout",
      "me": "GET /api/v1/auth/me"
    },
    "notes": "bearer+verified = requires valid access token AND phoneVerified=true. Auth errors: 401 unauthorized, 403 forbidden (phone not verified)."
  },
  "endpoints": [
    {"id":"request-otp","method":"POST","path":"/api/v1/auth/request-otp","auth":"none","summary":"Send 6-digit OTP to phone (E.164).","requestBody":{"required":["phone"],"fields":[{"name":"phone","type":"string","format":"E.164"}]},"responses":{"200":{"schema":{"message":"string","expiresInSeconds":"number","devCode":"string (dev only)"}},"422":{"schema":{"error":"string","details":"array"}}}},
    {"id":"verify-otp","method":"POST","path":"/api/v1/auth/verify-otp","auth":"none","summary":"Verify OTP, upsert user, return token pair.","requestBody":{"required":["phone","code"],"fields":[{"name":"phone","type":"string"},{"name":"code","type":"string","format":"6 digits"}]},"responses":{"200":{"schema":{"accessToken":"string","refreshToken":"string","profileComplete":"boolean","user":"Self"}},"400":{"schema":{"error":"string"}},"429":{"schema":{"error":"string"}}}},
    {"id":"refresh-token","method":"POST","path":"/api/v1/auth/refresh","auth":"none","summary":"Exchange refresh token for new access+refresh pair.","requestBody":{"required":["refreshToken"],"fields":[{"name":"refreshToken","type":"string"}]},"responses":{"200":{"schema":{"accessToken":"string","refreshToken":"string"}},"401":{"schema":{"error":"string"}}}},
    {"id":"logout","method":"POST","path":"/api/v1/auth/logout","auth":"bearer","summary":"Logout (stateless; client discards tokens).","responses":{"204":{}}},
    {"id":"get-me","method":"GET","path":"/api/v1/auth/me","auth":"bearer","summary":"Get authenticated user's full self profile.","responses":{"200":{"schema":"Self"}}},
    {"id":"update-profile","method":"PATCH","path":"/api/v1/me","auth":"bearer+verified","summary":"Update profile fields.","requestBody":{"fields":[{"name":"name","type":"string","maxLength":60},{"name":"age","type":"number"},{"name":"gender","type":"enum:Gender"},{"name":"bio","type":"string","maxLength":150},{"name":"height","type":"number","notes":"cm"},{"name":"weight","type":"number","notes":"kg"},{"name":"bodyType","type":"enum:BodyType"},{"name":"relationshipType","type":"enum:RelationshipType"},{"name":"lookingFor","type":"array<string>","max":10},{"name":"datingIntentions","type":"array<enum:DatingIntention>","max":2,"notes":"badges, max 2"},{"name":"interests","type":"array<string>","notes":"shared highlights"},{"name":"topArtists","type":"array<string>","notes":"shared highlights — top musical artists"},{"name":"tribes","type":"array<string>","max":3},{"name":"tags","type":"array<string>","max":10},{"name":"virtualDatingBadge","type":"boolean"}]},"responses":{"200":{"schema":"Self"}}},
    {"id":"update-settings","method":"PATCH","path":"/api/v1/me/settings","auth":"bearer+verified","summary":"Update safety/visibility/privacy toggles.","requestBody":{"fields":[{"name":"verifiedOnly","type":"boolean"},{"name":"proximityShrink","type":"boolean","notes":"clamp radius to ~500m"},{"name":"stealthMode","type":"boolean","notes":"pause inbound messages"},{"name":"discoverable","type":"boolean"},{"name":"showDistance","type":"boolean","notes":"distance toggle"},{"name":"locationDealbreaker","type":"boolean"},{"name":"nationwideMode","type":"boolean"},{"name":"incognito","type":"boolean","premium":true},{"name":"appIcon","type":"string","notes":"discreet app icon key"},{"name":"screenshotBlock","type":"boolean"},{"name":"blockOffensiveLanguage","type":"boolean"}]},"responses":{"200":{"schema":"UserSettings"}}},
    {"id":"update-location","method":"POST","path":"/api/v1/me/location","auth":"bearer+verified","summary":"Push live GPS to Redis geo index. Coordinates never persisted or returned.","requestBody":{"required":["lat","lng"],"fields":[{"name":"lat","type":"number"},{"name":"lng","type":"number"}]},"responses":{"200":{"schema":{"ok":"boolean"}}}},
    {"id":"add-photo","method":"POST","path":"/api/v1/me/photos","auth":"bearer+verified","summary":"Add a profile or private photo by URL. First public photo becomes primary. Discovery requires min 3 public photos.","requestBody":{"required":["url"],"fields":[{"name":"url","type":"string","format":"url"},{"name":"isPrimary","type":"boolean"},{"name":"isPrivate","type":"boolean"},{"name":"albumId","type":"uuid","notes":"private album"}]},"responses":{"201":{"schema":"Photo"}}},
    {"id":"set-primary-photo","method":"PUT","path":"/api/v1/me/photos/:photoId/primary","auth":"bearer+verified","summary":"Set primary profile photo.","responses":{"200":{"schema":{"ok":"boolean"}},"404":{}}},
    {"id":"delete-photo","method":"DELETE","path":"/api/v1/me/photos/:photoId","auth":"bearer+verified","summary":"Delete a photo.","responses":{"204":{},"404":{}}},
    {"id":"list-prompts","method":"GET","path":"/api/v1/me/prompts","auth":"bearer+verified","summary":"List own personality prompts.","responses":{"200":{"schema":{"prompts":"array<ProfilePrompt>"}}}},
    {"id":"add-prompt","method":"POST","path":"/api/v1/me/prompts","auth":"bearer+verified","summary":"Add a personality prompt (max 6).","requestBody":{"required":["prompt","answer"],"fields":[{"name":"prompt","type":"string","maxLength":120},{"name":"answer","type":"string","maxLength":300},{"name":"order","type":"number"}]},"responses":{"201":{"schema":"ProfilePrompt"},"400":{"schema":{"error":"string"}}}},
    {"id":"update-prompt","method":"PATCH","path":"/api/v1/me/prompts/:promptId","auth":"bearer+verified","summary":"Update a personality prompt.","responses":{"200":{"schema":"ProfilePrompt"},"404":{}}},
    {"id":"delete-prompt","method":"DELETE","path":"/api/v1/me/prompts/:promptId","auth":"bearer+verified","summary":"Delete a personality prompt.","responses":{"204":{},"404":{}}},
    {"id":"set-pin","method":"POST","path":"/api/v1/me/pin","auth":"bearer+verified","summary":"Set or change account PIN (4-8 digits).","requestBody":{"required":["pin"],"fields":[{"name":"pin","type":"string","format":"4-8 digits"}]},"responses":{"200":{"schema":{"ok":"boolean"}}}},
    {"id":"remove-pin","method":"DELETE","path":"/api/v1/me/pin","auth":"bearer+verified","summary":"Remove PIN (requires current PIN).","requestBody":{"required":["pin"]},"responses":{"200":{"schema":{"ok":"boolean"}},"403":{}}},
    {"id":"verify-pin","method":"POST","path":"/api/v1/me/pin/verify","auth":"bearer+verified","summary":"Verify PIN (e.g. on app resume).","requestBody":{"required":["pin"]},"responses":{"200":{"schema":{"valid":"boolean"}},"403":{}}},
    {"id":"get-catalogs","method":"GET","path":"/api/v1/catalogs","auth":"bearer+verified","summary":"Static catalogs for profile customization.","responses":{"200":{"schema":{"prompts":"array<string>","tribes":"array<string>","bodyTypes":"array<string>","datingIntentions":"array<{key,label}>"}}}},
    {"id":"get-public-profile","method":"GET","path":"/api/v1/users/:userId","auth":"bearer+verified","summary":"Public profile (Profile Inspection Overlay). Records a view unless viewer is incognito. Includes sharedHighlights.","responses":{"200":{"schema":"PublicProfile"},"404":{}}},
    {"id":"get-grid","method":"GET","path":"/api/v1/grid","auth":"bearer+verified","summary":"Live proximity grid with rich filters and ranked ordering.","query":[{"name":"lat","required":true},{"name":"lng","required":true},{"name":"radius","notes":"meters; clamped to settings"},{"name":"limit","default":20,"max":50},{"name":"offset","default":0},{"name":"onlineOnly","type":"boolean"},{"name":"ageMin","type":"number"},{"name":"ageMax","type":"number"},{"name":"heightMin","type":"number"},{"name":"heightMax","type":"number"},{"name":"bodyType","type":"string"},{"name":"tribes","notes":"comma-separated"},{"name":"tags","notes":"comma-separated"},{"name":"lookingFor","notes":"comma-separated"},{"name":"sort","enum":["distance","fresh"],"default":"distance"}],"responses":{"200":{"schema":{"radiusM":"number","total":"number","limit":"number","offset":"number","cards":"array<GridCard>"}}},"notes":"GridCard: {id,name,age,isVerified,photoVerified,bodyType,tribes,thumbnailUrl,distanceLabel|null,activity:{online,label},boosted}. showDistance=false sets distanceLabel=null. Requires min 3 public photos for discoverability."},
    {"id":"explore","method":"GET","path":"/api/v1/explore","auth":"bearer+verified","premium":true,"summary":"Worldwide user search with filters.","query":[{"name":"q","type":"string"},{"name":"ageMin"},{"name":"ageMax"},{"name":"bodyType"},{"name":"tribes","notes":"comma-separated"},{"name":"gender"},{"name":"limit","default":20},{"name":"offset","default":0}],"responses":{"200":{"schema":{"total":"number","users":"array<GridCard>"}}}},
    {"id":"for-you","method":"GET","path":"/api/v1/explore/for-you","auth":"bearer+verified","premium":true,"summary":"4 curated profiles based on shared tribes and interests.","responses":{"200":{"schema":{"profiles":"array<GridCard>"}}}},
    {"id":"list-favorites","method":"GET","path":"/api/v1/discovery/favorites","auth":"bearer+verified","summary":"List favorited users.","responses":{"200":{"schema":{"favorites":"array<GridCard>"}}}},
    {"id":"add-favorite","method":"POST","path":"/api/v1/discovery/favorites","auth":"bearer+verified","summary":"Favorite a user (unlimited per day, free).","requestBody":{"required":["userId"]},"responses":{"201":{"schema":{"id":"uuid"}},"400":{}}},
    {"id":"remove-favorite","method":"DELETE","path":"/api/v1/discovery/favorites/:userId","auth":"bearer+verified","summary":"Remove a favorite.","responses":{"204":{}}},
    {"id":"send-tap","method":"POST","path":"/api/v1/discovery/taps","auth":"bearer+verified","summary":"Send a tap (quick interest signal without messaging).","requestBody":{"required":["userId"]},"responses":{"201":{"schema":{"id":"uuid"}},"403":{}}},
    {"id":"received-taps","method":"GET","path":"/api/v1/discovery/taps","auth":"bearer+verified","summary":"Taps received from others.","responses":{"200":{"schema":{"taps":"array<{id,sender:GridCard,createdAt}>"}}}},
    {"id":"viewed-me","method":"GET","path":"/api/v1/discovery/views","auth":"bearer+verified","premium":true,"summary":"Who viewed your profile (recorded on GET /users/:id unless viewer is incognito).","responses":{"200":{"schema":{"views":"array<{id,viewer:GridCard,viewedAt}>"}}}},
    {"id":"list-albums","method":"GET","path":"/api/v1/discovery/albums","auth":"bearer+verified","summary":"List own private albums.","responses":{"200":{"schema":{"albums":"array<PrivateAlbum>"}}}},
    {"id":"create-album","method":"POST","path":"/api/v1/discovery/albums","auth":"bearer+verified","summary":"Create a private photo album.","requestBody":{"fields":[{"name":"name","type":"string","maxLength":80}]},"responses":{"201":{"schema":"PrivateAlbum"}}},
    {"id":"grant-album","method":"POST","path":"/api/v1/discovery/albums/:albumId/grant","auth":"bearer+verified","summary":"Grant a user access to a private album.","requestBody":{"required":["userId"]},"responses":{"201":{"schema":{"ok":"boolean"}},"404":{}}},
    {"id":"revoke-album","method":"DELETE","path":"/api/v1/discovery/albums/:albumId/grant/:userId","auth":"bearer+verified","summary":"Revoke album access.","responses":{"204":{}}},
    {"id":"shared-albums","method":"GET","path":"/api/v1/discovery/albums/shared","auth":"bearer+verified","summary":"Albums shared with you by others.","responses":{"200":{"schema":{"albums":"array<PrivateAlbum>"}}}},
    {"id":"verification-status","method":"GET","path":"/api/v1/verification/status","auth":"bearer+verified","summary":"Photo/face verification status.","responses":{"200":{"schema":{"photoVerified":"boolean","faceVerified":"boolean","isVerified":"boolean","history":"array"}}}},
    {"id":"verify-photo","method":"POST","path":"/api/v1/verification/photo","auth":"bearer+verified","summary":"Submit selfie photo for AI verification.","requestBody":{"required":["mediaUrl"]},"responses":{"201":{"schema":{"id":"uuid","status":"string","score":"number"}},"400":{}}},
    {"id":"verify-face","method":"POST","path":"/api/v1/verification/face","auth":"bearer+verified","summary":"Submit video selfie for AI face check.","requestBody":{"required":["mediaUrl"]},"responses":{"201":{"schema":{"id":"uuid","status":"string","score":"number"}},"400":{}}},
    {"id":"start-conversation","method":"POST","path":"/api/v1/conversations/start","auth":"bearer+verified","summary":"Start a DM with any user. New conversation lands in receiver's Requests folder (pending state). Receiver replying promotes it to active.","requestBody":{"required":["userId"]},"responses":{"200":{"schema":{"id":"uuid","state":"string"},"description":"Existing conversation"},"201":{"schema":{"id":"uuid","state":"pending"},"description":"New conversation"}}},
    {"id":"list-conversations","method":"GET","path":"/api/v1/conversations","auth":"bearer+verified","summary":"List conversations. folder=inbox (active) or folder=requests (pending, not initiated by you).","query":[{"name":"folder","enum":["inbox","requests"],"default":"inbox"}],"responses":{"200":{"schema":{"folder":"string","conversations":"array<ConversationSummary>"}}}},
    {"id":"list-messages","method":"GET","path":"/api/v1/conversations/:conversationId/messages","auth":"bearer+verified","summary":"Paginated messages (newest first). Excludes deleted messages.","query":[{"name":"before","type":"iso8601"},{"name":"limit","default":30,"max":100}],"responses":{"200":{"schema":{"messages":"array<Message>"}},"404":{}}},
    {"id":"send-message","method":"POST","path":"/api/v1/conversations/:conversationId/messages","auth":"bearer+verified","summary":"Send a message. Types: text|photo|video|voice|expiring_photo. Expiring photos: 1 view/10s, 5/day free. Also delivered via message.created socket.","requestBody":{"required":[],"fields":[{"name":"type","enum":["text","photo","video","voice","expiring_photo"],"default":"text"},{"name":"ciphertext","type":"string","maxLength":8192},{"name":"mediaUrls","type":"array<string>","max":10},{"name":"viewOnce","type":"boolean"},{"name":"expiresInSeconds","type":"number"}]},"responses":{"201":{"schema":"Message"},"402":{"description":"Expiring photo daily cap hit"},"404":{}}},
    {"id":"unsend-message","method":"POST","path":"/api/v1/conversations/:conversationId/messages/:messageId/unsend","auth":"bearer+verified","premium":true,"summary":"Unsend a message (soft-delete for everyone). Emits message.unsend to peer.","responses":{"200":{"schema":{"id":"uuid","deletedAt":"iso8601"}},"403":{},"404":{}}},
    {"id":"delete-message","method":"DELETE","path":"/api/v1/conversations/:conversationId/messages/:messageId","auth":"bearer+verified","summary":"Delete a message (sender only, own side).","responses":{"204":{},"403":{}}},
    {"id":"view-expiring-photo","method":"POST","path":"/api/v1/conversations/:conversationId/messages/:messageId/view","auth":"bearer+verified","summary":"Consume a 1-view expiring photo. Emits message.viewed to sender.","responses":{"200":{"schema":{"ok":"boolean"}},"409":{"description":"Already viewed"}}},
    {"id":"translate-message","method":"POST","path":"/api/v1/conversations/:conversationId/messages/:messageId/translate","auth":"bearer+verified","premium":true,"summary":"Translate message ciphertext (non-E2E / client-relay mode only).","requestBody":{"fields":[{"name":"targetLang","type":"string","default":"en"}]},"responses":{"200":{"schema":{"text":"string","detectedSourceLang":"string"}}}},
    {"id":"mark-read","method":"POST","path":"/api/v1/conversations/:conversationId/read","auth":"bearer+verified","summary":"Mark messages as read. Emits message.read to peer.","responses":{"200":{"schema":{"ok":"boolean"}}}},
    {"id":"delete-thread","method":"DELETE","path":"/api/v1/conversations/:conversationId","auth":"bearer+verified","summary":"Delete entire conversation thread (soft-delete for this user only).","responses":{"204":{}}},
    {"id":"dismiss-conversation","method":"POST","path":"/api/v1/conversations/:conversationId/dismiss","auth":"bearer+verified","summary":"Dismiss a pending message request (receiver only).","responses":{"200":{"schema":{"ok":"boolean"}},"403":{},"409":{}}},
    {"id":"list-phrases","method":"GET","path":"/api/v1/conversations/phrases","auth":"bearer+verified","premium":true,"summary":"List saved chat phrases.","responses":{"200":{"schema":{"phrases":"array<SavedPhrase>"}}}},
    {"id":"create-phrase","method":"POST","path":"/api/v1/conversations/phrases","auth":"bearer+verified","premium":true,"summary":"Add a saved chat phrase (max 20).","requestBody":{"required":["text"]},"responses":{"201":{"schema":"SavedPhrase"}}},
    {"id":"delete-phrase","method":"DELETE","path":"/api/v1/conversations/phrases/:phraseId","auth":"bearer+verified","premium":true,"summary":"Delete a saved phrase.","responses":{"204":{}}},
    {"id":"call-history","method":"GET","path":"/api/v1/calls","auth":"bearer+verified","summary":"Recent call history (placed + received).","query":[{"name":"limit","default":20},{"name":"offset","default":0}],"responses":{"200":{"schema":{"calls":"array<CallRecord>"}}}},
    {"id":"ice-config","method":"GET","path":"/api/v1/calls/ice-config","auth":"bearer+verified","summary":"STUN/TURN config for WebRTC clients.","responses":{"200":{"schema":{"iceServers":"array<{urls,username?,credential?}>"}}}},
    {"id":"billing-plans","method":"GET","path":"/api/v1/billing/plans","auth":"none","summary":"Localized pricing catalog.","responses":{"200":{"schema":"PricingMatrix"}}},
    {"id":"billing-wallet","method":"GET","path":"/api/v1/billing/wallet","auth":"bearer+verified","summary":"A-la-carte credit balance.","responses":{"200":{"schema":{"balance":"number"}}}},
    {"id":"billing-subscribe","method":"POST","path":"/api/v1/billing/subscribe","auth":"bearer+verified","summary":"Activate/upgrade subscription tier.","requestBody":{"required":["tier","externalRef"],"fields":[{"name":"tier","enum":["basic","advanced","vip"]},{"name":"externalRef","type":"string"},{"name":"periodDays","default":30}]},"responses":{"200":{"schema":{"tier":"string","expiresAt":"iso8601"}}}},
    {"id":"billing-purchase-credits","method":"POST","path":"/api/v1/billing/credits/purchase","auth":"bearer+verified","summary":"Buy a-la-carte intro credits.","requestBody":{"required":["quantity","externalRef"]},"responses":{"200":{"schema":{"balance":"number"}}}},
    {"id":"billing-create-boost","method":"POST","path":"/api/v1/billing/boosts","auth":"bearer+verified","premium":true,"summary":"Hyperlocal Feed Boost — pin card to top of grid for 30 min.","requestBody":{"required":["lat","lng","externalRef"]},"responses":{"201":{"schema":{"id":"uuid","expiresAt":"iso8601"}}}},
    {"id":"billing-active-boost","method":"GET","path":"/api/v1/billing/boosts/active","auth":"bearer+verified","summary":"Active feed boost, if any.","responses":{"200":{"schema":{"active":"boolean","boost":"object|null"}}}},
    {"id":"billing-verify-account","method":"POST","path":"/api/v1/billing/verify","auth":"bearer+verified","summary":"Grant trust-verification badge after purchase.","requestBody":{"required":["externalRef"]},"responses":{"200":{"schema":{"isVerified":"boolean"}}}},
    {"id":"safety-list-blocks","method":"GET","path":"/api/v1/safety/blocks","auth":"bearer+verified","summary":"List blocked users.","responses":{"200":{"schema":{"blocked":"array<{blockedId,createdAt}>"}}}},
    {"id":"safety-block","method":"POST","path":"/api/v1/safety/block","auth":"bearer+verified","summary":"Block a user.","requestBody":{"required":["userId"]},"responses":{"201":{"schema":{"ok":"boolean"}}}},
    {"id":"safety-unblock","method":"DELETE","path":"/api/v1/safety/block/:userId","auth":"bearer+verified","summary":"Unblock a user.","responses":{"204":{}}},
    {"id":"safety-report","method":"POST","path":"/api/v1/safety/report","auth":"bearer+verified","summary":"Report a user.","requestBody":{"required":["userId","reason"],"fields":[{"name":"userId","type":"uuid"},{"name":"reason","enum":["spam","harassment","fake_profile","inappropriate_content","other"]},{"name":"details","type":"string","maxLength":500}]},"responses":{"201":{"schema":{"ok":"boolean"}}}}
  ],
  "models": [
    {"name":"User","table":"users","fields":[{"name":"id","type":"uuid","primaryKey":true},{"name":"phone","type":"string","frontendVisible":false},{"name":"phoneVerified","type":"boolean"},{"name":"name","type":"string","nullable":true},{"name":"age","type":"number","nullable":true},{"name":"gender","type":"enum:Gender","nullable":true},{"name":"bio","type":"string","nullable":true,"notes":"max 150 chars"},{"name":"height","type":"number","nullable":true,"notes":"cm"},{"name":"weight","type":"number","nullable":true,"notes":"kg"},{"name":"bodyType","type":"enum:BodyType","nullable":true},{"name":"relationshipType","type":"enum:RelationshipType","nullable":true},{"name":"lookingFor","type":"array<string>"},{"name":"datingIntentions","type":"array<enum:DatingIntention>","notes":"max 2"},{"name":"interests","type":"array<string>"},{"name":"topArtists","type":"array<string>"},{"name":"tribes","type":"array<string>","notes":"max 3"},{"name":"tags","type":"array<string>","notes":"max 10"},{"name":"virtualDatingBadge","type":"boolean"},{"name":"isVerified","type":"boolean"},{"name":"photoVerified","type":"boolean"},{"name":"faceVerified","type":"boolean"},{"name":"tier","type":"enum:SubscriptionTier"},{"name":"reputationScore","type":"number","frontendVisible":false},{"name":"pinHash","type":"string","nullable":true,"frontendVisible":false},{"name":"lastActiveAt","type":"timestamp"},{"name":"createdAt","type":"timestamp"},{"name":"updatedAt","type":"timestamp"}],"notes":"Precise GPS NOT stored — Redis only."},
    {"name":"Photo","table":"photos","fields":[{"name":"id","type":"uuid"},{"name":"userId","type":"uuid"},{"name":"url","type":"string"},{"name":"isPrimary","type":"boolean"},{"name":"isPrivate","type":"boolean"},{"name":"albumId","type":"uuid","nullable":true},{"name":"order","type":"number"},{"name":"createdAt","type":"timestamp"}]},
    {"name":"ProfilePrompt","table":"profile_prompts","fields":[{"name":"id","type":"uuid"},{"name":"userId","type":"uuid"},{"name":"prompt","type":"string","maxLength":120},{"name":"answer","type":"string","maxLength":300},{"name":"order","type":"number"},{"name":"createdAt","type":"timestamp"}]},
    {"name":"UserSettings","table":"user_settings","fields":[{"name":"userId","type":"uuid"},{"name":"verifiedOnly","type":"boolean"},{"name":"proximityShrink","type":"boolean"},{"name":"stealthMode","type":"boolean"},{"name":"discoverable","type":"boolean"},{"name":"showDistance","type":"boolean"},{"name":"locationDealbreaker","type":"boolean"},{"name":"nationwideMode","type":"boolean"},{"name":"incognito","type":"boolean"},{"name":"appIcon","type":"string"},{"name":"screenshotBlock","type":"boolean"},{"name":"blockOffensiveLanguage","type":"boolean"}]},
    {"name":"Conversation","table":"conversations","fields":[{"name":"id","type":"uuid"},{"name":"userAId","type":"uuid"},{"name":"userBId","type":"uuid"},{"name":"initiatorId","type":"uuid"},{"name":"state","type":"enum:ConversationState"},{"name":"aArchivedAt","type":"timestamp","nullable":true},{"name":"bArchivedAt","type":"timestamp","nullable":true},{"name":"aDeletedAt","type":"timestamp","nullable":true},{"name":"bDeletedAt","type":"timestamp","nullable":true},{"name":"createdAt","type":"timestamp"},{"name":"lastMessageAt","type":"timestamp"}],"notes":"pending=Requests folder, active=inbox, dismissed=rejected. Receiver replying promotes pending→active."},
    {"name":"Message","table":"messages","fields":[{"name":"id","type":"uuid"},{"name":"conversationId","type":"uuid"},{"name":"senderId","type":"uuid"},{"name":"type","type":"enum:MessageType"},{"name":"ciphertext","type":"string","nullable":true,"notes":"E2E-encrypted payload"},{"name":"mediaUrls","type":"array<string>"},{"name":"viewOnce","type":"boolean"},{"name":"expiresInSeconds","type":"number","nullable":true},{"name":"viewedAt","type":"timestamp","nullable":true},{"name":"flaggedOffensive","type":"boolean"},{"name":"readAt","type":"timestamp","nullable":true},{"name":"deletedAt","type":"timestamp","nullable":true},{"name":"createdAt","type":"timestamp"}]},
    {"name":"Call","table":"calls","fields":[{"name":"id","type":"uuid"},{"name":"callerId","type":"uuid"},{"name":"calleeId","type":"uuid"},{"name":"type","type":"enum:CallType"},{"name":"status","type":"enum:CallStatus"},{"name":"startedAt","type":"timestamp"},{"name":"answeredAt","type":"timestamp","nullable":true},{"name":"endedAt","type":"timestamp","nullable":true},{"name":"durationSec","type":"number","nullable":true}]},
    {"name":"SavedPhrase","table":"saved_phrases","fields":[{"name":"id","type":"uuid"},{"name":"userId","type":"uuid"},{"name":"text","type":"string","maxLength":500},{"name":"order","type":"number"},{"name":"createdAt","type":"timestamp"}]},
    {"name":"Favorite","table":"favorites","fields":[{"name":"id","type":"uuid"},{"name":"userId","type":"uuid"},{"name":"favoriteId","type":"uuid"},{"name":"createdAt","type":"timestamp"}]},
    {"name":"Tap","table":"taps","fields":[{"name":"id","type":"uuid"},{"name":"senderId","type":"uuid"},{"name":"receiverId","type":"uuid"},{"name":"createdAt","type":"timestamp"}]},
    {"name":"ProfileView","table":"profile_views","fields":[{"name":"id","type":"uuid"},{"name":"viewerId","type":"uuid"},{"name":"viewedId","type":"uuid"},{"name":"createdAt","type":"timestamp"}]},
    {"name":"PrivateAlbum","table":"private_albums","fields":[{"name":"id","type":"uuid"},{"name":"ownerId","type":"uuid"},{"name":"name","type":"string"},{"name":"createdAt","type":"timestamp"}]},
