generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────

enum Gender {
  male
  female
  nonbinary
  other
}

enum SubscriptionTier {
  free
  basic
  advanced
  vip
}

enum BodyType {
  slim
  athletic
  average
  curvy
  heavyset
  prefer_not_to_say
  // legacy values kept for migration safety — app layer no longer accepts these
  muscular
  plus_size
  other
}

enum SkinTone {
  very_fair
  fair
  medium
  olive
  brown
  dark
  prefer_not_to_say
}

enum RelationshipStatus {
  single
  committed
  open_relationship
  prefer_not_to_say
}

enum LookingForOption {
  fwb
  one_night
  long_term
  short_term
  casual
  friendship
}

enum WhereWeCanMeet {
  my_place
  your_place
  restaurant
  cafe
  hotel
  outdoors
  virtual
}

enum DatingIntention {
  casual_dates
  intimacy_no_commitment
  life_partner
  ethical_non_monogamy
  marriage
  friendship
  virtual_dating
}

enum RelationshipType {
  single
  dating
  open_relationship
  married
  complicated
  prefer_not_to_say
}

enum ConversationState {
  pending
  active
  dismissed
}

enum MessageType {
  text
  photo
  video
  voice
  expiring_photo
  voice_note
}

enum CallType {
  audio
  video
}

enum CallStatus {
  ringing
  accepted
  declined
  missed
  canceled
  ended
  initiated
  ongoing
}

enum VerificationType {
  photo
  face
}

enum VerificationStatus {
  pending
  approved
  rejected
  none
  verified
}

enum ReportReason {
  spam
  harassment
  fake_profile
  inappropriate_content
  lgbtq_hate
  other
}

// ── NearMe v2 enums ──────────────────────────────────────

enum GenderIdentity {
  man
  woman
  non_binary
  trans_man
  trans_woman
  genderqueer
  genderfluid
  other
}

enum SexualOrientation {
  straight
  gay
  lesbian
  bisexual
  queer
  pansexual
  other
}

enum WantToSee {
  men
  women
  everyone
  non_binary_people
}

enum RelationshipIntent {
  dating
  friendship
  networking
  open_to_anything
}

enum Plan {
  free
  premium
  gold
  platinum
}

enum BillingCycle {
  monthly
  three_month
  six_month
  annual
}

enum AddOnType {
  boost_local
  boost_extended
  boost_city_wide
  mega_boost
  spotlight
  chat_pack_s
  chat_pack_m
  chat_pack_l
  travel_pass
  travel_pass_week
  verified_badge
  audio_call_topup
  video_call_topup
}

enum ModerationFlagType {
  explicit_sexual
  threat
  hate_speech
  anti_lgbtq
  nudity
  spam
}

// ─────────────────────────────────────────────────────────
// Core
// ─────────────────────────────────────────────────────────

model User {
  id            String  @id @default(uuid())
  phone         String? @unique
  phoneVerified Boolean @default(false)

  // ── Firebase auth ──
  firebaseUid   String? @unique @map("firebase_uid")
  email         String? @unique
  emailVerified Boolean @default(false) @map("email_verified")

  // ── basic profile ──
  name             String?
  age              Int?
  gender           Gender?
  bio              String?           @db.VarChar(600) // plan-limited: free=150, premium=400, gold/plat=600
  height           Int?
  weight           Int?
  bodyType         BodyType?
  relationshipType RelationshipType?

  // ── v3: extended profile fields (Change 5) ──
  skinTone          SkinTone?
  aboutMe           String?           @db.VarChar(500)
  whereAreYouFrom   String?
  relationshipStatus RelationshipStatus?
  whereWeCanMeet    WhereWeCanMeet[]
  preferences       String?
  fantasyTags       String[]

  // ── arrays / multi-select ──
  lookingFor       String[]          // validated against LookingForOption at app layer
  datingIntentions DatingIntention[]
  interests        String[]
  topArtists       String[]
  tribes           String[]
  tags             String[]
  virtualDatingBadge Boolean @default(false)

  // ── verification / trust ──
  // isVerified is computed: true when phoneVerified=true OR emailVerified=true.
  // (Face verification was removed — verifying via either phone OTP or email OTP
  // is sufficient. See migration 20260618_remove_face_verification.)
  isVerified    Boolean @default(false)
  photoVerified Boolean @default(false)
  // DEPRECATED: face verification was removed. Column retained to avoid a
  // destructive drop on existing data; it is no longer read or written anywhere.
  faceVerified  Boolean @default(false)

  tier            SubscriptionTier @default(free)
  reputationScore Float            @default(0.5)

  pinHash      String?
  lastActiveAt DateTime @default(now())

  // ── NearMe v2: identity fields ──
  genderIdentity      GenderIdentity?
  genderIdentityOther String?
  sexualOrientation   SexualOrientation?
  wantToSee           WantToSee[]
  relationshipIntent  RelationshipIntent?
  whoCanDiscoverMe    WantToSee[]
  firstName           String?

  // ── NearMe v2: plan-based subscription ──
  plan          Plan      @default(free)
  planExpiresAt DateTime?

  // ── NearMe v2: media ──
  voiceClipUrl String?
  videoClipUrl String?

  // ── NearMe v2: trust & verification ──
  verifiedBadge     Boolean @default(false)
  isCollegeVerified Boolean @default(false)
  profileCompletenessScore Float @default(0)

  // ── NearMe v2: persistent location (never exposed to other users) ──
  locationLat       Float?
  locationLng       Float?
  locationUpdatedAt DateTime?

  // ── NearMe v2: grid visibility ──
  // isOnGrid=false: manually hidden via panic-hide. 14-day inactivity is enforced via lastActiveAt filter, not this flag.
  isOnGrid Boolean @default(true)

  // ── NearMe v2: Gold+ privacy settings ──
  incognitoMode      Boolean @default(false)
  hideActiveStatus   Boolean @default(false)
  hideLastSeen       Boolean @default(false)
  hideExactDistance  Boolean @default(false)

  // ── NearMe v2: LGBTQ+ safety ──
  showOrientationPublicly Boolean @default(false)
  disceetMode             Boolean @default(false)

  // ── NearMe v2: women's safety defaults ──
  pauseIncomingMessages              Boolean @default(false)
  requireProfileCompletenessToMessage Boolean @default(false)
  verifiedUsersOnlyFilter            Boolean @default(false)

  // ── Removed in v3 (Change 6): dailyNewChatCount / dailyNewChatResetDate ──
  // Replaced by UserInteraction lifetime cap (free=20 unique people)

  // ── NearMe v2: free-tier call minutes ──
  dailyAudioMinutesUsed   Int       @default(0)
  dailyVideoMinutesUsed   Int       @default(0)
  dailyCallMinutesResetDate DateTime?

  // ── NearMe v2: grid ranking signal ──
  historicalReplyRate Float?

  // ── NearMe v2: Platinum AI opt-in feature flags ──
  aiOptInFeatures Json?

  // ── Right Now: ephemeral "what I'm up to" status (Change: right_now_fields) ──
  rightNowStatus    String?   @db.VarChar(120)
  rightNowCategory  String?   // drinks | coffee | workout | hangout | other
  rightNowExpiresAt DateTime? // status auto-clears once now() passes this

  // ── v3 Phase 6: Safety enforcement fields ──
  restrictedUntil             DateTime?
  isBanned                    Boolean   @default(false)
  bannedAt                    DateTime?
  interactionPenaltyUntil     DateTime?
  interactionPenaltyMultiplier Float?   @default(1.0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photos       Photo[]
  prompts      ProfilePrompt[]
  settings     UserSettings?
  wallet       CreditWallet?
  subscription Subscription?

  conversationsA Conversation[] @relation("UserA")
  conversationsB Conversation[] @relation("UserB")
  messages       Message[]

  feedBoosts   FeedBoost[]
  savedPhrases SavedPhrase[]
  verifications Verification[]

  favoritesMade Favorite[] @relation("FavoriteOwner")
  favoritedBy   Favorite[] @relation("FavoriteTarget")
  tapsSent      Tap[]      @relation("TapSender")
  tapsReceived  Tap[]      @relation("TapReceiver")
  viewsMade     ProfileView[] @relation("Viewer")
  viewsReceived ProfileView[] @relation("Viewed")

  albums      PrivateAlbum[]
  albumGrants PrivateAlbumGrant[] @relation("Grantee")

  // v3: new album feature (Change 7)
  ownedAlbums  Album[]      @relation("UserAlbums")
  albumPhotos  AlbumPhoto[] @relation("AlbumPhotoOwner")

  callsPlaced   Call[] @relation("Caller")
  callsReceived Call[] @relation("Callee")

  blocksMade     Block[]  @relation("Blocker")
  blocksAgainst  Block[]  @relation("Blocked")
  reportsMade    Report[] @relation("Reporter")
  reportsAgainst Report[] @relation("Reported")

  mutesMade      Mute[]          @relation("MuteOwner")
  mutesAgainst   Mute[]          @relation("MuteTarget")
  addOnPurchases AddOnPurchase[]
  messageTemplates MessageTemplate[]
  cityProfiles   CityProfile[]

  // v3: interaction tracking (Change 6)
  interactionsMade     UserInteraction[] @relation("InteractionActor")
  interactionsReceived UserInteraction[] @relation("InteractionTarget")

  refreshTokens RefreshToken[]

  // ── Dating Rooms (Groups) ──
  roomsCreated    Room[]
  roomMemberships RoomMember[]
  roomMessages    RoomMessage[]
  roomReactions   RoomMessageReaction[]

  @@index([lastActiveAt])
  @@index([createdAt])
  @@index([plan])
  @@index([isOnGrid, lastActiveAt])
  @@index([rightNowExpiresAt])
  @@map("users")
}

model Photo {
  id          String   @id @default(uuid())
  userId      String
  url         String
  isPrimary   Boolean  @default(false)
  isPrivate   Boolean  @default(false)
  isPublished Boolean  @default(true)  // false = pending manual moderation review
  albumId     String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  album PrivateAlbum? @relation(fields: [albumId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([albumId])
  @@map("photos")
}

model ProfilePrompt {
  id        String   @id @default(uuid())
  userId    String
  prompt    String   @db.VarChar(120)
  answer    String   @db.VarChar(300)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("profile_prompts")
}

model UserSettings {
  userId String @id

  verifiedOnly        Boolean @default(false)
  proximityShrink     Boolean @default(false)
  stealthMode         Boolean @default(false)
  discoverable        Boolean @default(true)
  showDistance        Boolean @default(true)
  locationDealbreaker Boolean @default(false)
  nationwideMode      Boolean @default(false)
  incognito           Boolean @default(false)

  appIcon                String  @default("default")
  screenshotBlock        Boolean @default(false)
  blockOffensiveLanguage Boolean @default(false)

  activeLast5MinFilter  Boolean @default(false)
  recentlyJoinedFilter  Boolean @default(false)
  highReplyRateFilter   Boolean @default(false)
  activeLast30MinFilter Boolean @default(false)

  customDistanceKm Float?

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// ─────────────────────────────────────────────────────────
// Messaging & calls
// ─────────────────────────────────────────────────────────

model Conversation {
  id          String            @id @default(uuid())
  userAId     String
  userBId     String
  initiatorId String
  state       ConversationState @default(pending)

  // v3: call gate — replaced callUnlocked with per-side reply flags (Change 2)
  // audioCallEnabled / videoCallEnabled = true when the OTHER party (non-caller) has replied
  aHasReplied Boolean @default(false) // User A has sent at least one message
  bHasReplied Boolean @default(false) // User B has sent at least one message

  // v3: conversation visibility — set by block (Change 1)
  // aIsHidden=true means the conversation is hidden from User A's inbox
  aIsHidden Boolean @default(false)
  bIsHidden Boolean @default(false)

  aPinned Boolean @default(false)
  bPinned Boolean @default(false)

  aArchivedAt DateTime?
  bArchivedAt DateTime?
  aDeletedAt  DateTime?
  bDeletedAt  DateTime?

  createdAt     DateTime @default(now())
  lastMessageAt DateTime @default(now())

  userA    User      @relation("UserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB    User      @relation("UserB", fields: [userBId], references: [id], onDelete: Cascade)
  messages Message[]
  calls    Call[]

  @@unique([userAId, userBId])
  @@index([userAId, lastMessageAt])
  @@index([userBId, lastMessageAt])
  @@map("conversations")
}

model Message {
  id             String      @id @default(uuid())
  conversationId String
  senderId       String
  type           MessageType @default(text)

  ciphertext String?
  content    String?
  mediaUrls  String[]
  mediaUrl   String?

  viewOnce         Boolean   @default(false)
  expiresInSeconds Int?
  viewedAt         DateTime?
  expiresAfterView Boolean   @default(false)

  isUnsent    Boolean   @default(false)
  unsentAt    DateTime?

  isEdited        Boolean   @default(false)
  editedAt        DateTime?
  originalContent String?

  translatedContent String?

  flaggedOffensive  Boolean   @default(false)
  moderationFlagged Boolean   @default(false)
  deliveredAt       DateTime?
  readAt            DateTime?
  deletedAt         DateTime?

  createdAt DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Call {
  id          String     @id @default(uuid())
  callerId    String
  calleeId    String
  type        CallType
  status      CallStatus @default(ringing)
  startedAt   DateTime   @default(now())
  answeredAt  DateTime?
  endedAt     DateTime?
  durationSec Int?

  conversationId String?

  agoraChannelName String?
  agoraToken       String?

  durationSeconds Int?
  endReason       String?

  scheduledAt DateTime?

  caller       User          @relation("Caller", fields: [callerId], references: [id], onDelete: Cascade)
  callee       User          @relation("Callee", fields: [calleeId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id])

  @@index([callerId, startedAt])
  @@index([calleeId, startedAt])
  @@map("calls")
}

model SavedPhrase {
  id        String   @id @default(uuid())
  userId    String
  text      String   @db.VarChar(500)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("saved_phrases")
}

// ─────────────────────────────────────────────────────────
// Discovery
// ─────────────────────────────────────────────────────────

model Favorite {
  id         String   @id @default(uuid())
  userId     String
  favoriteId String
  createdAt  DateTime @default(now())

  user     User @relation("FavoriteOwner", fields: [userId], references: [id], onDelete: Cascade)
  favorite User @relation("FavoriteTarget", fields: [favoriteId], references: [id], onDelete: Cascade)

  @@unique([userId, favoriteId])
  @@index([userId])
  @@map("favorites")
}

model Tap {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  createdAt  DateTime @default(now())

  sender   User @relation("TapSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("TapReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([receiverId, createdAt])
  @@map("taps")
}

model ProfileView {
  id        String   @id @default(uuid())
  viewerId  String
  viewedId  String
  createdAt DateTime @default(now())

  viewer User @relation("Viewer", fields: [viewerId], references: [id], onDelete: Cascade)
  viewed User @relation("Viewed", fields: [viewedId], references: [id], onDelete: Cascade)

  @@unique([viewerId, viewedId])
  @@index([viewedId, createdAt])
  @@map("profile_views")
}

model PrivateAlbum {
  id        String   @id @default(uuid())
  ownerId   String
  name      String   @default("Private Album")
  createdAt DateTime @default(now())

  owner  User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  photos Photo[]
  grants PrivateAlbumGrant[]

  @@index([ownerId])
  @@map("private_albums")
}

model PrivateAlbumGrant {
  id        String   @id @default(uuid())
  albumId   String
  granteeId String
  createdAt DateTime @default(now())

  album   PrivateAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  grantee User         @relation("Grantee", fields: [granteeId], references: [id], onDelete: Cascade)

  @@unique([albumId, granteeId])
  @@index([granteeId])
  @@map("private_album_grants")
}

// ─────────────────────────────────────────────────────────
// v3: Album feature (Change 7)
// ─────────────────────────────────────────────────────────

model Album {
  id           String    @id @default(uuid())
  userId       String
  title        String    @db.VarChar(50)
  coverPhotoId String?   @unique // nullable FK to AlbumPhoto; a photo can be cover of at most one album
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime? // soft delete

  user       User         @relation("UserAlbums", fields: [userId], references: [id], onDelete: Cascade)
  photos     AlbumPhoto[] @relation("AlbumPhotos")
  coverPhoto AlbumPhoto?  @relation("AlbumCover", fields: [coverPhotoId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([userId])
  @@map("albums")
}

model AlbumPhoto {
  id        String   @id @default(uuid())
  albumId   String
  userId    String
  photoUrl  String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  album   Album  @relation("AlbumPhotos", fields: [albumId], references: [id], onDelete: Cascade)
  user    User   @relation("AlbumPhotoOwner", fields: [userId], references: [id], onDelete: Cascade)
  coverOf Album? @relation("AlbumCover")

  @@index([albumId, order])
  @@index([userId])
  @@map("album_photos")
}

// ─────────────────────────────────────────────────────────
// Verification
// ─────────────────────────────────────────────────────────

model Verification {
  id         String             @id @default(uuid())
  userId     String
  type       VerificationType
  status     VerificationStatus @default(pending)
  mediaUrl   String
  score      Float?
  reason     String?
  createdAt  DateTime           @default(now())
  reviewedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("verifications")
}

// ─────────────────────────────────────────────────────────
// Monetization
// ─────────────────────────────────────────────────────────

model Subscription {
  id          String           @id @default(uuid())
  userId      String           @unique
  tier        SubscriptionTier
  active      Boolean          @default(true)
  startedAt   DateTime         @default(now())
  expiresAt   DateTime
  externalRef String?

  plan        Plan?
  billingCycle BillingCycle?
  priceInr    Int?
  paymentProvider String?
  providerSubscriptionId String?
  cancelledAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model CreditWallet {
  userId    String   @id
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledger CreditLedger[]

  @@map("credit_wallets")
}

model CreditLedger {
  id           String   @id @default(uuid())
  userId       String
  delta        Int
  reason       String
  balanceAfter Int
  createdAt    DateTime @default(now())

  wallet CreditWallet @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("credit_ledger")
}

model FeedBoost {
  id        String   @id @default(uuid())
  userId    String
  geohash   String
  startedAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("feed_boosts")
}

// ─────────────────────────────────────────────────────────
// Safety
// ─────────────────────────────────────────────────────────

model Block {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId, blockerId]) // fast reverse lookup for bidirectional block checks
  @@map("blocks")
}

model Report {
  id         String       @id @default(uuid())
  reporterId String
  reportedId String
  reason     ReportReason
  details    String?      @db.VarChar(500)
  createdAt  DateTime     @default(now())

  reporter User @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reported User @relation("Reported", fields: [reportedId], references: [id], onDelete: Cascade)

  @@index([reportedId])
  @@map("reports")
}

// ─────────────────────────────────────────────────────────
// NearMe v2 — models
// ─────────────────────────────────────────────────────────

model Mute {
  id      String @id @default(uuid())
  muterId String
  mutedId String

  createdAt DateTime @default(now())

  muter User @relation("MuteOwner", fields: [muterId], references: [id], onDelete: Cascade)
  muted User @relation("MuteTarget", fields: [mutedId], references: [id], onDelete: Cascade)

  @@unique([muterId, mutedId])
  @@index([muterId])
  @@map("mutes")
}

model AddOnPurchase {
  id      String    @id @default(uuid())
  userId  String
  addOnType AddOnType

  priceInr     Int
  chatSlotsAdded Int?
  audioMinutesAdded Int?
  videoMinutesAdded Int?

  activatedAt DateTime @default(now())
  expiresAt   DateTime?
  isActive    Boolean   @default(true)

  paymentProvider String
  providerOrderId String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([userId, expiresAt])
  @@map("add_on_purchases")
}

model MessageTemplate {
  id           String @id @default(uuid())
  userId       String
  content      String
  displayOrder Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("message_templates")
}

model CityProfile {
  id       String @id @default(uuid())
  userId   String
  cityName String

  lat Float
  lng Float

  isActive         Boolean @default(false)
  visitingSoonBadge Boolean @default(true)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("city_profiles")
}

model ModerationFlag {
  id         String             @id @default(uuid())
  targetType String
  targetId   String
  flagType   ModerationFlagType
  status     String             @default("pending")

  reviewedAt DateTime?
  reviewedBy String?

  createdAt DateTime @default(now())

  @@index([targetType, targetId])
  @@index([status, createdAt])
  @@map("moderation_flags")
}

// ─────────────────────────────────────────────────────────
// v3: Interaction tracking for free-tier lifetime cap (Change 6)
// ─────────────────────────────────────────────────────────

model UserInteraction {
  id              String   @id @default(uuid())
  actorId         String   // user who initiated the interaction
  targetId        String   // user they interacted with
  interactionType String   @default("message") // "message" | "like"
  createdAt       DateTime @default(now())

  actor  User @relation("InteractionActor", fields: [actorId], references: [id], onDelete: Cascade)
  target User @relation("InteractionTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([actorId, targetId])
  @@index([actorId])
  @@map("user_interactions")
}

// ─────────────────────────────────────────────────────────
// Security: Refresh token family invalidation (Section 1.1)
// ─────────────────────────────────────────────────────────

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  family    String
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────────────────
// Dating Rooms (Groups) — 20260619_dating_rooms
// ─────────────────────────────────────────────────────────

enum RoomCategory {
  city_dating
  orientation
  age_group
  relationship_intent
  events
  local_meetups
}

enum RoomRole {
  member
  moderator
  admin
}

enum RoomMessageType {
  text
  image
  system
  voice
}

model Room {
  id              String        @id @default(uuid())
  name            String        @db.VarChar(100)
  description     String?       @db.VarChar(500)
  category        RoomCategory
  city            String?
  state           String?
  country         String        @default("India")
  isOfficial      Boolean       @default(false)
  isVerifiedOnly  Boolean       @default(false)
  coverImageUrl   String?
  creatorId       String?
  memberCount     Int           @default(0)
  onlineCount     Int           @default(0)
  lastActivityAt  DateTime      @default(now())
  isActive        Boolean       @default(true)
  rules           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  members         RoomMember[]
  messages        RoomMessage[]
  reports         RoomReport[]
  mutes           RoomMute[]
  creator         User?         @relation(fields: [creatorId], references: [id])

  @@index([category, isActive])
  @@index([city, isActive])
  @@index([lastActivityAt])
}

model RoomMember {
  id        String    @id @default(uuid())
  roomId    String
  userId    String
  role      RoomRole  @default(member)
  joinedAt  DateTime  @default(now())
  isMuted   Boolean   @default(false)
  room      Room      @relation(fields: [roomId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@unique([roomId, userId])
  @@index([userId])
}

model RoomMessage {
  id                String                @id @default(uuid())
  roomId            String
  senderId          String
  content           String                @db.Text
  type              RoomMessageType       @default(text)
  mediaUrl          String?
  replyToId         String?
  isDeleted         Boolean               @default(false)
  isPinned          Boolean               @default(false)
  moderationFlagged Boolean               @default(false)
  deliveredAt       DateTime?
  createdAt         DateTime              @default(now())
  editedAt          DateTime?
  room              Room                  @relation(fields: [roomId], references: [id])
  sender            User                  @relation(fields: [senderId], references: [id])
  replyTo           RoomMessage?          @relation("RoomMessageReply", fields: [replyToId], references: [id])
  replies           RoomMessage[]         @relation("RoomMessageReply")
  reactions         RoomMessageReaction[]
  deliveries        RoomMessageDelivery[]

  @@index([roomId, createdAt])
  @@index([senderId])
}

model RoomMessageDelivery {
  id          String      @id @default(uuid())
  messageId   String
  userId      String
  deliveredAt DateTime    @default(now())
  message     RoomMessage @relation(fields: [messageId], references: [id])

  @@unique([messageId, userId])
  @@index([messageId])
}

model RoomMessageReaction {
  id        String      @id @default(uuid())
  messageId String
  userId    String
  emoji     String      @db.VarChar(10)
  createdAt DateTime    @default(now())
  message   RoomMessage @relation(fields: [messageId], references: [id])
  user      User        @relation(fields: [userId], references: [id])

  @@unique([messageId, userId, emoji])
}

model RoomReport {
  id         String   @id @default(uuid())
  roomId     String
  reporterId String
  reason     String
  details    String?
  createdAt  DateTime @default(now())
  room       Room     @relation(fields: [roomId], references: [id])

  @@index([roomId])
}

model RoomMute {
  id        String   @id @default(uuid())
  roomId    String
  userId    String
  createdAt DateTime @default(now())
  room      Room     @relation(fields: [roomId], references: [id])

  @@unique([roomId, userId])
}
