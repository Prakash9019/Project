# ── Server ──────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Database (PostgreSQL) ───────────────────────────────
# Transaction-mode pooler (application traffic)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/proximity_social?schema=public"
# Session-mode pooler (Prisma migrations — must be direct / non-pgbouncer)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/proximity_social?schema=public"

# ── Redis (geo-spatial index, OTP store, rate limits) ───
REDIS_URL="redis://localhost:6379"

# ── Auth / JWT ──────────────────────────────────────────
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"

# ── OTP ─────────────────────────────────────────────────
OTP_TTL_SECONDS=300
# In development, OTP codes are returned in the response. Set to "false" in prod.
OTP_DEV_RETURN=true

# ── Demo seed login (@nearme.dev personas — dev only) ───
DEV_SEED_PASSWORD="NearMeDemo1!"
DEV_LOGIN_ENABLED=true

# ── Discovery / Grid ────────────────────────────────────
# Default discovery radius in meters
DEFAULT_RADIUS_M=5000
# Proximity-shrink radius in meters (safety toggle)
SHRINK_RADIUS_M=500
# Distances are fuzzed to this granularity (km) before being sent to clients
DISTANCE_FUZZ_KM=0.1
# Seconds since lastActive within which a user is considered "online"
ONLINE_WINDOW_SECONDS=120

# ── Intro request daily caps (free tier) ────────────────
FREE_TIER_DAILY_REQUESTS=5

# ── Feed boost ──────────────────────────────────────────
FEED_BOOST_DURATION_MINUTES=30

# ── Expiring photos ─────────────────────────────────────
# Free-tier daily limit on outgoing 1-view expiring photos
FREE_TIER_DAILY_EXPIRING_PHOTOS=5
# Default countdown (seconds) once an expiring photo is opened
EXPIRING_PHOTO_VIEW_SECONDS=10

# ── Media (Cloudflare R2 — S3-compatible) ─────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
MEDIA_BASE_URL=https://<bucket>.r2.cloudflarestorage.com

# ── Billing / calls (required at boot — presence-checked) ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# ── WebRTC calls (signaling only; backend relays offer/answer/ICE) ──
# Comma-separated STUN/TURN URLs surfaced via GET /api/v1/calls/ice-config
STUN_URLS="stun:stun.l.google.com:19302"
TURN_URL=""
# Coturn `use-auth-secret` (TURN REST API): backend derives short-lived per-client
# credentials from this shared secret via HMAC-SHA1. Must match coturn's `static-auth-secret`.
TURN_SECRET=""
TURN_REALM=""
TURN_TTL=86400
# Legacy static credentials — only used if TURN_SECRET is empty. Leave blank for prod.
TURN_USERNAME=""
TURN_CREDENTIAL=""

# ── Explore / nationwide ────────────────────────────────
# Radius (meters) used for "nationwide mode" expansion
NATIONWIDE_RADIUS_M=2000000

# ── CORS ────────────────────────────────────────────────
CORS_ORIGIN="*"

# ── AI (Chat Translate — Premium feature; icebreakers, reply suggestions,
#    compatibility, daily top 10, profile optimizer) ────────────────────
# Claude — used by content moderation only (migrated separately from
# the AI features above, which all now call Gemini).
ANTHROPIC_API_KEY=""
# Gemini — backend-only key, never expose as EXPO_PUBLIC_GEMINI_API_KEY.
# Must be non-empty for any test that mocks global.fetch against the
# Gemini call path, since env.gemini.apiKey is captured once at
# module-import time.
GEMINI_API_KEY=""

# ── Image moderation (AWS Rekognition) ──────────────────
# NOT WIRED YET: services/imageModeration.ts still has a stub in place of the
# DetectModerationLabels call, so every uploaded image is returned unchecked.
# Setting these alone does NOT activate moderation — see the file header.
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# What moderateImage() returns while no provider is wired.
#   allow          (default) — publish uploads normally
#   manual_review  — accept uploads but leave them unpublished for a human
IMAGE_MODERATION_FALLBACK="allow"

# ── Payments ────────────────────────────────────────────
# adapters/stripe.ts is STILL A STUB whose retrievePaymentIntent always reports
# "succeeded". It is hard-disabled in production (see stripeConfigured), so
# every production payment routes through Razorpay regardless of this key.
STRIPE_SECRET_KEY=""

# ── Rate limiting ───────────────────────────────────────
# Set to "true" to disable every HTTP rate-limit bucket (the test suite does
# this in src/tests/setup.ts). Leave unset in production.
RATE_LIMIT_DISABLED=""
