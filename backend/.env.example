# ── Server ──────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Database (PostgreSQL) ───────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/proximity_social?schema=public"

# ── Redis (geo-spatial index, OTP store, rate limits) ───
REDIS_URL="redis://localhost:6379"

# ── Auth / JWT ──────────────────────────────────────────
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"

# ── OTP ─────────────────────────────────────────────────
OTP_TTL_SECONDS=300
# In development, OTP codes are returned in the response. Set to "false" in prod.
OTP_DEV_RETURN=true

# ── Discovery / Grid ────────────────────────────────────
# Default discovery radius in meters
DEFAULT_RADIUS_M=5000
# Proximity-shrink radius in meters (safety toggle)
SHRINK_RADIUS_M=500
# Distances are fuzzed to this granularity (km) before being sent to clients
DISTANCE_FUZZ_KM=0.1
# Seconds since lastActive within which a user is considered "online"
ONLINE_WINDOW_SECONDS=120

# ── Intro request daily caps (free tier) ────────────────
FREE_TIER_DAILY_REQUESTS=5

# ── Feed boost ──────────────────────────────────────────
FEED_BOOST_DURATION_MINUTES=30

# ── Expiring photos ─────────────────────────────────────
# Free-tier daily limit on outgoing 1-view expiring photos
FREE_TIER_DAILY_EXPIRING_PHOTOS=5
# Default countdown (seconds) once an expiring photo is opened
EXPIRING_PHOTO_VIEW_SECONDS=10

# ── Media ───────────────────────────────────────────────
# Base URL clients upload media to (signed-URL storage). Backend stores only URLs.
MEDIA_BASE_URL="https://media.yourapp.com"

# ── WebRTC calls (signaling only; backend relays offer/answer/ICE) ──
# Comma-separated STUN/TURN URLs surfaced via GET /api/v1/calls/ice-config
STUN_URLS="stun:stun.l.google.com:19302"
TURN_URL=""
TURN_USERNAME=""
TURN_CREDENTIAL=""

# ── Explore / nationwide ────────────────────────────────
# Radius (meters) used for "nationwide mode" expansion
NATIONWIDE_RADIUS_M=2000000

# ── CORS ────────────────────────────────────────────────
CORS_ORIGIN="*"
