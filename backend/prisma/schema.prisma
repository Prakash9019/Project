generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────

enum Gender {
  male
  female
  nonbinary
  other
}

enum SubscriptionTier {
  free
  basic
  advanced
  vip
}

enum BodyType {
  slim
  athletic
  average
  muscular
  curvy
  plus_size
  other
}

enum DatingIntention {
  casual_dates
  intimacy_no_commitment
  life_partner
  ethical_non_monogamy
  marriage
  friendship
  virtual_dating
}

enum RelationshipType {
  single
  dating
  open_relationship
  married
  complicated
  prefer_not_to_say
}

enum ConversationState {
  pending // first DM from a stranger — sits in the receiver's "Requests" folder
  active // accepted / replied to — lives in the main inbox
  dismissed // receiver dismissed the request
}

enum MessageType {
  text
  photo
  video
  voice
  expiring_photo
}

enum CallType {
  audio
  video
}

enum CallStatus {
  ringing
  accepted
  declined
  missed
  canceled
  ended
}

enum VerificationType {
  photo
  face
}

enum VerificationStatus {
  pending
  approved
  rejected
}

enum ReportReason {
  spam
  harassment
  fake_profile
  inappropriate_content
  other
}

// ─────────────────────────────────────────────────────────
// Core
// ─────────────────────────────────────────────────────────

model User {
  id            String  @id @default(uuid())
  phone         String  @unique // E.164, verified via OTP
  phoneVerified Boolean @default(false)

  // ── basic profile (all optional) ──
  name             String?
  age              Int?
  gender           Gender?
  bio              String?           @db.VarChar(150) // single-line bio, capped at 150 chars
  height           Int? // cm
  weight           Int? // kg
  bodyType         BodyType?
  relationshipType RelationshipType?

  // ── arrays / multi-select profile data ──
  lookingFor       String[] // free-form "looking for" tags
  datingIntentions DatingIntention[] // badges — at most 2 (enforced in service)
  interests        String[] // shared highlights
  topArtists       String[] // shared highlights — top musical artists
  tribes           String[] // up to 3 subculture tags
  tags             String[] // up to 10 personal tags
  virtualDatingBadge Boolean @default(false)

  // ── verification / trust ──
  isVerified    Boolean @default(false) // paid trust-verification badge
  photoVerified Boolean @default(false) // AI/selfie photo verification
  faceVerified  Boolean @default(false) // video-selfie face check

  tier            SubscriptionTier @default(free)
  reputationScore Float            @default(0.5) // 0..1, blended acceptance + reply rate

  pinHash      String? // optional PIN-lock hash (never exposed to frontend)
  lastActiveAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photos       Photo[]
  prompts      ProfilePrompt[]
  settings     UserSettings?
  wallet       CreditWallet?
  subscription Subscription?

  conversationsA Conversation[] @relation("UserA")
  conversationsB Conversation[] @relation("UserB")
  messages       Message[]

  feedBoosts FeedBoost[]
  savedPhrases SavedPhrase[]
  verifications Verification[]

  favoritesMade Favorite[] @relation("FavoriteOwner")
  favoritedBy   Favorite[] @relation("FavoriteTarget")
  tapsSent      Tap[]      @relation("TapSender")
  tapsReceived  Tap[]      @relation("TapReceiver")
  viewsMade     ProfileView[] @relation("Viewer")
  viewsReceived ProfileView[] @relation("Viewed")

  albums       PrivateAlbum[]
  albumGrants  PrivateAlbumGrant[] @relation("Grantee")

  callsPlaced   Call[] @relation("Caller")
  callsReceived Call[] @relation("Callee")

  blocksMade     Block[]  @relation("Blocker")
  blocksAgainst  Block[]  @relation("Blocked")
  reportsMade    Report[] @relation("Reporter")
  reportsAgainst Report[] @relation("Reported")

  @@index([lastActiveAt])
  @@index([createdAt])
  @@map("users")
}

model Photo {
  id        String   @id @default(uuid())
  userId    String
  url       String
  isPrimary Boolean  @default(false)
  isPrivate Boolean  @default(false) // belongs to a private album, not the public profile
  albumId   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  album PrivateAlbum? @relation(fields: [albumId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([albumId])
  @@map("photos")
}

model ProfilePrompt {
  id        String   @id @default(uuid())
  userId    String
  prompt    String   @db.VarChar(120)
  answer    String   @db.VarChar(300)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("profile_prompts")
}

model UserSettings {
  userId String @id

  // discovery / visibility
  verifiedOnly        Boolean @default(false) // hide unverified accounts
  proximityShrink     Boolean @default(false) // clamp visible radius to SHRINK_RADIUS_M
  stealthMode         Boolean @default(false) // pause inbound requests, keep chats alive
  discoverable        Boolean @default(true)
  showDistance        Boolean @default(true) // distance toggle
  locationDealbreaker Boolean @default(false) // only see (and be seen by) within radius
  nationwideMode      Boolean @default(false) // expand discovery to country scale
  incognito           Boolean @default(false) // browse without being recorded as a viewer

  // privacy
  appIcon                String  @default("default") // discreet app icon choice
  screenshotBlock        Boolean @default(false) // block screenshots in private album (client-enforced)
  blockOffensiveLanguage Boolean @default(false) // hide offensive inbound messages

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// ─────────────────────────────────────────────────────────
// Messaging & calls
// ─────────────────────────────────────────────────────────

model Conversation {
  id          String            @id @default(uuid())
  userAId     String
  userBId     String
  initiatorId String // who sent the first message
  state       ConversationState @default(pending)

  // per-side archive / soft-delete for thread management
  aArchivedAt DateTime?
  bArchivedAt DateTime?
  aDeletedAt  DateTime?
  bDeletedAt  DateTime?

  createdAt     DateTime @default(now())
  lastMessageAt DateTime @default(now())

  userA    User      @relation("UserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB    User      @relation("UserB", fields: [userBId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([userAId, userBId])
  @@index([userAId, lastMessageAt])
  @@index([userBId, lastMessageAt])
  @@map("conversations")
}

model Message {
  id             String      @id @default(uuid())
  conversationId String
  senderId       String
  type           MessageType @default(text)

  // E2E text payload (opaque ciphertext). Media lives at signed URLs the client encrypts/uploads.
  ciphertext String?
  mediaUrls  String[] // photo(s) / video / voice attachments

  // expiring photo semantics
  viewOnce        Boolean @default(false)
  expiresInSeconds Int? // e.g. 10 — countdown once opened
  viewedAt        DateTime? // when the (single) recipient opened it

  flaggedOffensive Boolean   @default(false) // set by moderation adapter
  readAt           DateTime?
  deletedAt        DateTime? // unsend / delete-for-everyone

  createdAt DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Call {
  id          String     @id @default(uuid())
  callerId    String
  calleeId    String
  type        CallType
  status      CallStatus @default(ringing)
  startedAt   DateTime   @default(now())
  answeredAt  DateTime?
  endedAt     DateTime?
  durationSec Int?

  caller User @relation("Caller", fields: [callerId], references: [id], onDelete: Cascade)
  callee User @relation("Callee", fields: [calleeId], references: [id], onDelete: Cascade)

  @@index([callerId, startedAt])
  @@index([calleeId, startedAt])
  @@map("calls")
}

model SavedPhrase {
  id        String   @id @default(uuid())
  userId    String
  text      String   @db.VarChar(500)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("saved_phrases")
}

// ─────────────────────────────────────────────────────────
// Discovery
// ─────────────────────────────────────────────────────────

model Favorite {
  id         String   @id @default(uuid())
  userId     String // owner
  favoriteId String // favorited user
  createdAt  DateTime @default(now())

  user     User @relation("FavoriteOwner", fields: [userId], references: [id], onDelete: Cascade)
  favorite User @relation("FavoriteTarget", fields: [favoriteId], references: [id], onDelete: Cascade)

  @@unique([userId, favoriteId])
  @@index([userId])
  @@map("favorites")
}

model Tap {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  createdAt  DateTime @default(now())

  sender   User @relation("TapSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("TapReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([receiverId, createdAt])
  @@map("taps")
}

model ProfileView {
  id        String   @id @default(uuid())
  viewerId  String
  viewedId  String
  createdAt DateTime @default(now())

  viewer User @relation("Viewer", fields: [viewerId], references: [id], onDelete: Cascade)
  viewed User @relation("Viewed", fields: [viewedId], references: [id], onDelete: Cascade)

  @@unique([viewerId, viewedId])
  @@index([viewedId, createdAt])
  @@map("profile_views")
}

model PrivateAlbum {
  id        String   @id @default(uuid())
  ownerId   String
  name      String   @default("Private Album")
  createdAt DateTime @default(now())

  owner  User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  photos Photo[]
  grants PrivateAlbumGrant[]

  @@index([ownerId])
  @@map("private_albums")
}

model PrivateAlbumGrant {
  id        String   @id @default(uuid())
  albumId   String
  granteeId String
  createdAt DateTime @default(now())

  album   PrivateAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  grantee User         @relation("Grantee", fields: [granteeId], references: [id], onDelete: Cascade)

  @@unique([albumId, granteeId])
  @@index([granteeId])
  @@map("private_album_grants")
}

// ─────────────────────────────────────────────────────────
// Verification
// ─────────────────────────────────────────────────────────

model Verification {
  id         String             @id @default(uuid())
  userId     String
  type       VerificationType
  status     VerificationStatus @default(pending)
  mediaUrl   String // selfie photo / video-selfie URL submitted for review
  score      Float? // confidence from the AI adapter
  reason     String? // rejection reason
  createdAt  DateTime           @default(now())
  reviewedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("verifications")
}

// ─────────────────────────────────────────────────────────
// Monetization
// ─────────────────────────────────────────────────────────

model Subscription {
  id          String           @id @default(uuid())
  userId      String           @unique
  tier        SubscriptionTier
  active      Boolean          @default(true)
  startedAt   DateTime         @default(now())
  expiresAt   DateTime
  externalRef String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model CreditWallet {
  userId    String   @id
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledger CreditLedger[]

  @@map("credit_wallets")
}

model CreditLedger {
  id           String   @id @default(uuid())
  userId       String
  delta        Int
  reason       String
  balanceAfter Int
  createdAt    DateTime @default(now())

  wallet CreditWallet @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("credit_ledger")
}

model FeedBoost {
  id        String   @id @default(uuid())
  userId    String
  geohash   String
  startedAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("feed_boosts")
}

// ─────────────────────────────────────────────────────────
// Safety
// ─────────────────────────────────────────────────────────

model Block {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@map("blocks")
}

model Report {
  id         String       @id @default(uuid())
  reporterId String
  reportedId String
  reason     ReportReason
  details    String?      @db.VarChar(500)
  createdAt  DateTime     @default(now())

  reporter User @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reported User @relation("Reported", fields: [reportedId], references: [id], onDelete: Cascade)

  @@index([reportedId])
  @@map("reports")
}
